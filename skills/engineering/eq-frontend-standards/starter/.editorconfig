# Matches .oxfmtrc.json. Without this the editor fights the formatter on the first keystroke.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# JSON follows the global 4, because oxfmt formats it at `tabWidth` and the standard's own config
# files are authored at 4. Only YAML is carved out — see `.oxfmtrc.json`'s override for why.
[*.{yml,yaml}]
indent_size = 2
