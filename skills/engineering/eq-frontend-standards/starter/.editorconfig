# Matches .oxfmtrc.json. Without this the editor fights the formatter on the first keystroke.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

# YAML stays 2-space (matches the .oxfmtrc.json override).
[*.{yml,yaml}]
indent_size = 2
