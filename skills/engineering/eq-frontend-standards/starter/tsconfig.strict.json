/* THE MIGRATION ARTIFACT for existing repos — not a second gate. Exactly one spelling of the flag
 * is live per repo: greenfield has it in tsconfig.app.json and this file is a 0-error no-op
 * (delete nothing); a migrating repo removes it there, keeps it here, and ratchets the count down
 * via the typecheck-strict-ratchet CI job — at 0, this file, its baseline and the job are deleted
 * together. Run explicitly (`tsc -p tsconfig.strict.json --noEmit`); deliberately not in the
 * root's references. Full story: eq-frontend-standards references/starter-rationale.md. */
{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    /* Own build-info path so ratchet and typecheck runs cannot poison each other's cache. */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.strict.tsbuildinfo",

    /* Restated so the file is self-contained after a migrating repo removes it from the app config. */
    "noUncheckedIndexedAccess": true
  }
}
