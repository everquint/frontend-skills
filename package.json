{
  "name": "frontend-skills",
  "version": "1.9.0",
  "private": true,
  "description": "Frontend engineering standards as installable agent skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/everquint/frontend-skills"
  },
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "link": "bash scripts/link-skills.sh",
    "validate": "node scripts/validate-skills.mjs && node scripts/validate-claims.mjs",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-standard-version.mjs",
    "release": "changeset tag"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7"
  },
  "packageManager": "npm@10.9.4",
  "author": "gokulsgr"
}
